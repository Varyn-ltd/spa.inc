# Supabase PostgreSQL connection string (pooled, used at runtime)
DATABASE_URL=

# Supabase direct connection (used for Prisma migrations)
DIRECT_URL=

# Supabase project URL (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon/public key (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key — SERVER ONLY, never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=
